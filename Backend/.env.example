PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-frontend.example.com
# Optional additional frontend origins, separated by commas.
CORS_ORIGINS=
# Use "lax" when both services are behind the same site/reverse proxy.
COOKIE_SAME_SITE=none
